rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasActiveParentProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // --- Validation Blueprints ---
    function isValidPractitionerProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'problemStatement',
          'ageStage',
          'preferredLocale',
          'themePreference',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'problemStatement',
          'ageStage',
          'preferredLocale',
          'themePreference',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.problemStatement is string && data.problemStatement.size() >= 3 && data.problemStatement.size() <= 500 &&
        data.ageStage is string && data.ageStage.size() <= 16 && data.ageStage in ['15-17', '18-29', '30-45', '46+', '15-19', '20-29'] &&
        data.preferredLocale is string && data.preferredLocale.size() <= 8 && data.preferredLocale in ['en', 'sw', 'fr', 'ar', 'uk', 'es'] &&
        data.themePreference is string && data.themePreference.size() <= 8 && data.themePreference in ['light', 'dark'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSkillCapability(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'title',
          'domain',
          'proofSummary',
          'verificationStatus',
          'confidenceScore',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'title',
          'domain',
          'proofSummary',
          'portfolioRef',
          'certificationRef',
          'peerEndorsement',
          'verificationStatus',
          'confidenceScore',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.domain is string && data.domain.size() >= 2 && data.domain.size() <= 60 &&
        data.proofSummary is string && data.proofSummary.size() >= 4 && data.proofSummary.size() <= 600 &&
        (!('portfolioRef' in data) || (data.portfolioRef is string && data.portfolioRef.size() <= 300)) &&
        (!('certificationRef' in data) || (data.certificationRef is string && data.certificationRef.size() <= 200)) &&
        (!('peerEndorsement' in data) || (data.peerEndorsement is string && data.peerEndorsement.size() <= 400)) &&
        data.verificationStatus is string && data.verificationStatus.size() <= 32 && data.verificationStatus in ['pending', 'field-verified', 'master-endorsed'] &&
        data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCompetencyPassport(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'studioDomain',
          'inputMode',
          'ageStageTrack',
          'fieldMatch',
          'executiveSummary',
          'microBridgeTitle',
          'microBridgeAction',
          'stipendEligible',
          'verifiedSkillLabels',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'studioDomain',
          'inputMode',
          'ageStageTrack',
          'fieldMatch',
          'executiveSummary',
          'microBridgeTitle',
          'microBridgeAction',
          'stipendEligible',
          'verifiedSkillLabels',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.studioDomain is string && data.studioDomain.size() <= 32 && data.studioDomain in ['Tech', 'Green Energy', 'Healthcare Ops', 'SME Finance'] &&
        data.inputMode is string && data.inputMode.size() <= 16 && data.inputMode in ['summary', 'scenario'] &&
        data.ageStageTrack is string && data.ageStageTrack.size() >= 2 && data.ageStageTrack.size() <= 120 &&
        data.fieldMatch is string && data.fieldMatch.size() >= 2 && data.fieldMatch.size() <= 160 &&
        data.executiveSummary is string && data.executiveSummary.size() >= 4 && data.executiveSummary.size() <= 600 &&
        data.microBridgeTitle is string && data.microBridgeTitle.size() >= 2 && data.microBridgeTitle.size() <= 160 &&
        data.microBridgeAction is string && data.microBridgeAction.size() >= 4 && data.microBridgeAction.size() <= 500 &&
        data.stipendEligible is bool &&
        data.verifiedSkillLabels is list && data.verifiedSkillLabels.size() >= 1 && data.verifiedSkillLabels.size() <= 6 && data.verifiedSkillLabels[0] is string && data.verifiedSkillLabels[0].size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBriefSubmission(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'briefId',
          'briefTitle',
          'domain',
          'status',
          'solutionNotes',
          'hoursLogged',
          'payoutUsd',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'briefId',
          'briefTitle',
          'domain',
          'status',
          'solutionNotes',
          'hoursLogged',
          'payoutUsd',
          'milestonesDone',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.briefId is string && isValidId(data.briefId) &&
        data.briefTitle is string && data.briefTitle.size() >= 2 && data.briefTitle.size() <= 140 &&
        data.domain is string && data.domain.size() >= 2 && data.domain.size() <= 60 &&
        data.status is string && data.status.size() <= 24 && data.status in ['in-progress', 'completed'] &&
        data.solutionNotes is string && data.solutionNotes.size() <= 2000 &&
        data.hoursLogged is number && data.hoursLogged >= 0 && data.hoursLogged <= 500 &&
        data.payoutUsd is number && data.payoutUsd >= 0 && data.payoutUsd <= 50000 &&
        (!('milestonesDone' in data) || (data.milestonesDone is list && data.milestonesDone.size() <= 3 && data.milestonesDone.hasOnly(['analysis-complete', 'draft-ready', 'final-submission']) && (data.milestonesDone.size() == 0 || (data.milestonesDone[0] is string && data.milestonesDone[0].size() <= 32)))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkReadyVault(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'identityCompleted',
          'identityPathway',
          'contractCompleted',
          'contractTemplate',
          'payoutCompleted',
          'payoutRail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'identityCompleted',
          'identityPathway',
          'contractCompleted',
          'contractTemplate',
          'payoutCompleted',
          'payoutRail',
          'financialIdentityCleared',
          'financialRailTested',
          'financialTaxCleared',
          'financialRail',
          'onboardingPackGenerated',
          'onboardingContractStructure',
          'onboardingPartnerOrg',
          'onboardingHostCountry',
          'proofPortfolioReady',
          'proofSkillTrack',
          'proofLocalScore',
          'proofRemoteScore',
          'workplaceSignalsCount',
          'matchedWorkCount',
          'appliedOpportunityIds',
          'upskillingBridgesCount',
          'lockedBridgeOpportunityIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.identityCompleted is bool &&
        data.identityPathway is string && data.identityPathway.size() <= 32 && data.identityPathway in ['remote-contractor', 'host-country-permit', 'eor-bridge'] &&
        data.contractCompleted is bool &&
        data.contractTemplate is string && data.contractTemplate.size() <= 32 && data.contractTemplate in ['milestone-sprint', 'local-services', 'cross-border-advisory'] &&
        data.payoutCompleted is bool &&
        data.payoutRail is string && data.payoutRail.size() <= 32 && data.payoutRail in ['mobile-money', 'local-bank', 'global-wallet'] &&
        (!('financialIdentityCleared' in data) || data.financialIdentityCleared is bool) &&
        (!('financialRailTested' in data) || data.financialRailTested is bool) &&
        (!('financialTaxCleared' in data) || data.financialTaxCleared is bool) &&
        (!('financialRail' in data) || (data.financialRail is string && data.financialRail.size() <= 32 && data.financialRail in ['mobile-money', 'global-wallet', 'fiscal-host', 'local-bank'])) &&
        (!('onboardingPackGenerated' in data) || data.onboardingPackGenerated is bool) &&
        (!('onboardingContractStructure' in data) || (data.onboardingContractStructure is string && data.onboardingContractStructure.size() <= 32 && data.onboardingContractStructure in ['direct-local', 'scoped-remote', 'eor-fiscal-host'])) &&
        (!('onboardingPartnerOrg' in data) || (data.onboardingPartnerOrg is string && data.onboardingPartnerOrg.size() <= 120)) &&
        (!('onboardingHostCountry' in data) || (data.onboardingHostCountry is string && data.onboardingHostCountry.size() <= 80)) &&
        (!('proofPortfolioReady' in data) || data.proofPortfolioReady is bool) &&
        (!('proofSkillTrack' in data) || (data.proofSkillTrack is string && data.proofSkillTrack.size() <= 32 && data.proofSkillTrack in ['trades-solar', 'craft-tailoring', 'business-finance', 'digital-code', 'agri-care'])) &&
        (!('proofLocalScore' in data) || (data.proofLocalScore is number && data.proofLocalScore >= 0 && data.proofLocalScore <= 100)) &&
        (!('proofRemoteScore' in data) || (data.proofRemoteScore is number && data.proofRemoteScore >= 0 && data.proofRemoteScore <= 100)) &&
        (!('workplaceSignalsCount' in data) || (data.workplaceSignalsCount is number && data.workplaceSignalsCount >= 0 && data.workplaceSignalsCount <= 3)) &&
        (!('matchedWorkCount' in data) || (data.matchedWorkCount is number && data.matchedWorkCount >= 0 && data.matchedWorkCount <= 50)) &&
        (!('appliedOpportunityIds' in data) || (data.appliedOpportunityIds is list && data.appliedOpportunityIds.size() <= 20 && (data.appliedOpportunityIds.size() == 0 || (data.appliedOpportunityIds[0] is string && data.appliedOpportunityIds[0].size() <= 64)))) &&
        (!('upskillingBridgesCount' in data) || (data.upskillingBridgesCount is number && data.upskillingBridgesCount >= 0 && data.upskillingBridgesCount <= 50)) &&
        (!('lockedBridgeOpportunityIds' in data) || (data.lockedBridgeOpportunityIds is list && data.lockedBridgeOpportunityIds.size() <= 20 && (data.lockedBridgeOpportunityIds.size() == 0 || (data.lockedBridgeOpportunityIds[0] is string && data.lockedBridgeOpportunityIds[0].size() <= 64)))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPeerEndorsement(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'collaboratorName',
          'collaboratorRole',
          'organization',
          'capabilityTitle',
          'endorsementText',
          'status',
          'shareToken',
          'sourceTab',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'collaboratorName',
          'collaboratorRole',
          'organization',
          'capabilityTitle',
          'endorsementText',
          'status',
          'shareToken',
          'sourceTab',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.collaboratorName is string && data.collaboratorName.size() >= 2 && data.collaboratorName.size() <= 80 &&
        data.collaboratorRole is string && data.collaboratorRole.size() >= 2 && data.collaboratorRole.size() <= 80 &&
        data.organization is string && data.organization.size() >= 2 && data.organization.size() <= 120 &&
        data.capabilityTitle is string && data.capabilityTitle.size() >= 2 && data.capabilityTitle.size() <= 140 &&
        data.endorsementText is string && data.endorsementText.size() <= 400 &&
        data.status is string && data.status.size() <= 24 && data.status in ['requested', 'verified'] &&
        data.shareToken is string && isValidId(data.shareToken) &&
        data.sourceTab is string && data.sourceTab.size() <= 16 && data.sourceTab in ['verify', 'unlock'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContractPayout(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'partnerOrg',
          'amountUsd',
          'payoutRail',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'partnerOrg',
          'amountUsd',
          'payoutRail',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.sprintId is string && isValidId(data.sprintId) &&
        data.sprintTitle is string && data.sprintTitle.size() >= 2 && data.sprintTitle.size() <= 160 &&
        data.partnerOrg is string && data.partnerOrg.size() >= 2 && data.partnerOrg.size() <= 120 &&
        data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 50000 &&
        data.payoutRail is string && data.payoutRail.size() <= 32 && data.payoutRail in ['mobile-money', 'local-bank', 'global-wallet'] &&
        data.status is string && data.status.size() <= 24 && data.status in ['escrow-held', 'processing', 'released'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSprintFeedback(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'contributionId',
          'briefId',
          'briefTitle',
          'partnerOrg',
          'reviewerName',
          'reviewerRole',
          'rating',
          'reviewText',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'contributionId',
          'briefId',
          'briefTitle',
          'partnerOrg',
          'reviewerName',
          'reviewerRole',
          'rating',
          'reviewText',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.contributionId is string && isValidId(data.contributionId) &&
        data.briefId is string && isValidId(data.briefId) &&
        data.briefTitle is string && data.briefTitle.size() >= 2 && data.briefTitle.size() <= 160 &&
        data.partnerOrg is string && data.partnerOrg.size() >= 2 && data.partnerOrg.size() <= 120 &&
        data.reviewerName is string && data.reviewerName.size() >= 2 && data.reviewerName.size() <= 80 &&
        data.reviewerRole is string && data.reviewerRole.size() >= 2 && data.reviewerRole.size() <= 100 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.reviewText is string && data.reviewText.size() >= 10 && data.reviewText.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorMessage(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'mentorId',
          'mentorName',
          'sender',
          'body',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'mentorId',
          'mentorName',
          'sender',
          'body',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.sprintId is string && isValidId(data.sprintId) &&
        data.sprintTitle is string && data.sprintTitle.size() >= 2 && data.sprintTitle.size() <= 160 &&
        data.mentorId is string && isValidId(data.mentorId) &&
        data.mentorName is string && data.mentorName.size() >= 2 && data.mentorName.size() <= 80 &&
        data.sender is string && data.sender.size() <= 24 && data.sender in ['practitioner', 'mentor'] &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorshipSession(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'mentorId',
          'mentorName',
          'focusTopic',
          'durationMinutes',
          'status',
          'takeawayNote',
          'attendedAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'sprintId',
          'sprintTitle',
          'mentorId',
          'mentorName',
          'focusTopic',
          'durationMinutes',
          'status',
          'takeawayNote',
          'attendedAtIso',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.sprintId is string && isValidId(data.sprintId) &&
        data.sprintTitle is string && data.sprintTitle.size() >= 2 && data.sprintTitle.size() <= 160 &&
        data.mentorId is string && isValidId(data.mentorId) &&
        data.mentorName is string && data.mentorName.size() >= 2 && data.mentorName.size() <= 80 &&
        data.focusTopic is string && data.focusTopic.size() <= 32 && data.focusTopic in ['qa-architecture', 'technical-unblocker', 'handover-rubric', 'career-rpl'] &&
        data.durationMinutes is int && data.durationMinutes >= 15 && data.durationMinutes <= 60 &&
        data.status is string && data.status.size() <= 16 && data.status in ['attended', 'scheduled'] &&
        data.takeawayNote is string && data.takeawayNote.size() >= 1 && data.takeawayNote.size() <= 600 &&
        data.attendedAtIso is string && data.attendedAtIso.size() >= 10 && data.attendedAtIso.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorPairing(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'trackId',
          'trackTitle',
          'domain',
          'mentorId',
          'mentorName',
          'preferredCadence',
          'sprintGoals',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'trackId',
          'trackTitle',
          'domain',
          'mentorId',
          'mentorName',
          'sprintId',
          'sprintTitle',
          'preferredCadence',
          'sprintGoals',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.trackId is string && data.trackId.size() <= 64 && isValidId(data.trackId) &&
        data.trackTitle is string && data.trackTitle.size() >= 2 && data.trackTitle.size() <= 120 &&
        data.domain is string && data.domain.size() <= 32 && data.domain in ['Tech', 'Green Energy', 'Healthcare Ops', 'SME Finance'] &&
        data.mentorId is string && isValidId(data.mentorId) &&
        data.mentorName is string && data.mentorName.size() >= 2 && data.mentorName.size() <= 80 &&
        (!('sprintId' in data) || (data.sprintId is string && isValidId(data.sprintId))) &&
        (!('sprintTitle' in data) || (data.sprintTitle is string && data.sprintTitle.size() >= 2 && data.sprintTitle.size() <= 160)) &&
        data.preferredCadence is string && data.preferredCadence.size() <= 32 && data.preferredCadence in ['weekly-check-in', 'milestone-gates', 'async-review'] &&
        data.sprintGoals is string && data.sprintGoals.size() >= 10 && data.sprintGoals.size() <= 800 &&
        data.status is string && data.status.size() <= 24 && data.status in ['requested', 'matched', 'active'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorRating(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'trackId',
          'trackTitle',
          'domain',
          'mentorId',
          'mentorName',
          'rating',
          'comment',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'trackId',
          'trackTitle',
          'domain',
          'mentorId',
          'mentorName',
          'rating',
          'comment',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.trackId is string && data.trackId.size() <= 64 && isValidId(data.trackId) &&
        data.trackTitle is string && data.trackTitle.size() >= 2 && data.trackTitle.size() <= 120 &&
        data.domain is string && data.domain.size() <= 32 && data.domain in ['Tech', 'Green Energy', 'Healthcare Ops', 'SME Finance'] &&
        data.mentorId is string && isValidId(data.mentorId) &&
        data.mentorName is string && data.mentorName.size() >= 2 && data.mentorName.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorshipTrackProgress(data, userId, trackId) {
      return data.keys().hasAll([
          'ownerUid',
          'trackId',
          'completedObjectiveIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'trackId',
          'completedObjectiveIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.trackId is string && data.trackId == trackId && data.trackId.size() <= 64 && isValidId(data.trackId) &&
        data.completedObjectiveIds is list && data.completedObjectiveIds.size() <= 10 &&
        (data.completedObjectiveIds.size() == 0 || (data.completedObjectiveIds[0] is string && data.completedObjectiveIds[0].size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCollaborationNote(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'contributionId',
          'briefId',
          'briefTitle',
          'markdownBody',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'contributionId',
          'briefId',
          'briefTitle',
          'markdownBody',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && isValidId(data.ownerUid) &&
        data.contributionId is string && isValidId(data.contributionId) &&
        data.briefId is string && isValidId(data.briefId) &&
        data.briefTitle is string && data.briefTitle.size() >= 2 && data.briefTitle.size() <= 160 &&
        data.markdownBody is string && data.markdownBody.size() >= 1 && data.markdownBody.size() <= 4000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMentorshipJournalEntry(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'contributionId',
          'briefId',
          'briefTitle',
          'mentorId',
          'mentorName',
          'sessionDateIso',
          'focusTopic',
          'reflectionTitle',
          'reflectionBody',
          'nextActionStep',
