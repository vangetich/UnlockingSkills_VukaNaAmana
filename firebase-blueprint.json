{
  "entities": {
    "PractitionerProfile": {
      "title": "PractitionerProfile",
      "description": "Private practitioner profile, problem-solving focus, career stage, and sync preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the practitioner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Practitioner preferred name."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified account email (owner-only PII)."
        },
        "problemStatement": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Answer to: What real-world problems do you know how to solve?"
        },
        "ageStage": {
          "type": "string",
          "enum": ["15-17", "18-29", "30-45", "46+", "15-19", "20-29"],
          "maxLength": 16,
          "description": "Career age-stage selection."
        },
        "preferredLocale": {
          "type": "string",
          "enum": ["en", "sw", "fr", "ar", "uk", "es"],
          "maxLength": 8,
          "description": "Preferred UI language code."
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 8,
          "description": "Preferred color theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "problemStatement",
        "ageStage",
        "preferredLocale",
        "themePreference",
        "createdAt",
        "updatedAt"
      ]
    },
    "SkillCapability": {
      "title": "SkillCapability",
      "description": "A verified or pending real-world skill capability submitted by a practitioner, including optional portfolio, certification, or peer endorsement evidence.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "proofSummary": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "portfolioRef": {
          "type": "string",
          "maxLength": 300
        },
        "certificationRef": {
          "type": "string",
          "maxLength": 200
        },
        "peerEndorsement": {
          "type": "string",
          "maxLength": 400
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["pending", "field-verified", "master-endorsed"],
          "maxLength": 32
        },
        "confidenceScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "title",
        "domain",
        "proofSummary",
        "verificationStatus",
        "confidenceScore",
        "createdAt",
        "updatedAt"
      ]
    },
    "CompetencyPassport": {
      "title": "CompetencyPassport",
      "description": "AI-verified Living Competency Passport generated from a practitioner's Show, Don't Tell submission.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "studioDomain": {
          "type": "string",
          "enum": ["Tech", "Green Energy", "Healthcare Ops", "SME Finance"],
          "maxLength": 32
        },
        "inputMode": {
          "type": "string",
          "enum": ["summary", "scenario"],
          "maxLength": 16
        },
        "ageStageTrack": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "fieldMatch": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "executiveSummary": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "microBridgeTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "microBridgeAction": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "stipendEligible": {
          "type": "boolean"
        },
        "verifiedSkillLabels": {
          "type": "array",
          "description": "Bounded list (max 6) of verified core skill strings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "studioDomain",
        "inputMode",
        "ageStageTrack",
        "fieldMatch",
        "executiveSummary",
        "microBridgeTitle",
        "microBridgeAction",
        "stipendEligible",
        "verifiedSkillLabels",
        "createdAt",
        "updatedAt"
      ]
    },
    "BriefSubmission": {
      "title": "BriefSubmission",
      "description": "An accepted or completed paid problem-solving brief contribution.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "briefId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "briefTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "domain": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["in-progress", "completed"],
          "maxLength": 24
        },
        "solutionNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "hoursLogged": {
          "type": "number"
        },
        "payoutUsd": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "briefId",
        "briefTitle",
        "domain",
        "status",
        "solutionNotes",
        "hoursLogged",
        "payoutUsd",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkReadyVault": {
      "title": "WorkReadyVault",
      "description": "Private 3-step work-authorization, contract template, and compliant payout rail readiness record for a practitioner.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "identityCompleted": {
          "type": "boolean"
        },
        "identityPathway": {
          "type": "string",
          "enum": ["remote-contractor", "host-country-permit", "eor-bridge"],
          "maxLength": 32
        },
        "contractCompleted": {
          "type": "boolean"
        },
        "contractTemplate": {
          "type": "string",
          "enum": ["milestone-sprint", "local-services", "cross-border-advisory"],
          "maxLength": 32
        },
        "payoutCompleted": {
          "type": "boolean"
        },
        "payoutRail": {
          "type": "string",
          "enum": ["mobile-money", "local-bank", "global-wallet"],
          "maxLength": 32
        },
        "financialIdentityCleared": {
          "type": "boolean"
        },
        "financialRailTested": {
          "type": "boolean"
        },
        "financialTaxCleared": {
          "type": "boolean"
        },
        "financialRail": {
          "type": "string",
          "enum": ["mobile-money", "global-wallet", "fiscal-host", "local-bank"],
          "maxLength": 32
        },
        "onboardingPackGenerated": {
          "type": "boolean"
        },
        "onboardingContractStructure": {
          "type": "string",
          "enum": ["direct-local", "scoped-remote", "eor-fiscal-host"],
          "maxLength": 32
        },
        "onboardingPartnerOrg": {
          "type": "string",
          "maxLength": 120
        },
        "onboardingHostCountry": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "identityCompleted",
        "identityPathway",
        "contractCompleted",
        "contractTemplate",
        "payoutCompleted",
        "payoutRail",
        "createdAt",
        "updatedAt"
      ]
    },
    "PeerEndorsement": {
      "title": "PeerEndorsement",
      "description": "Short text-based peer endorsement request or verified collaborator attestation strengthening a practitioner's Living Competency Passport.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "collaboratorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "collaboratorRole": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "organization": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "capabilityTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "endorsementText": {
          "type": "string",
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["requested", "verified"],
          "maxLength": 24
        },
        "shareToken": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "sourceTab": {
          "type": "string",
          "enum": ["verify", "unlock"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "collaboratorName",
        "collaboratorRole",
        "organization",
        "capabilityTitle",
        "endorsementText",
        "status",
        "shareToken",
        "sourceTab",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContractPayout": {
      "title": "ContractPayout",
      "description": "Tracks the lifecycle of a contract sprint payment across Escrow Held, Processing, and Released statuses.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "sprintId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "sprintTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "partnerOrg": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "amountUsd": {
          "type": "number"
        },
        "payoutRail": {
          "type": "string",
          "enum": ["mobile-money", "local-bank", "global-wallet"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["escrow-held", "processing", "released"],
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "sprintId",
        "sprintTitle",
        "partnerOrg",
        "amountUsd",
        "payoutRail",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SprintFeedback": {
      "title": "SprintFeedback",
      "description": "Qualitative Hiring Partner star rating and written review on a completed sprint contribution.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "contributionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "briefId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "briefTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "partnerOrg": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "reviewerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "reviewerRole": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reviewText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "contributionId",
        "briefId",
        "briefTitle",
        "partnerOrg",
        "reviewerName",
        "reviewerRole",
        "rating",
        "reviewText",
        "createdAt",
        "updatedAt"
      ]
    },
    "MentorMessage": {
      "title": "MentorMessage",
      "description": "Pod mentorship message thread entry exchanged between a practitioner and an assigned Senior Specialist.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "sprintId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "sprintTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "mentorId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "mentorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "sender": {
          "type": "string",
          "enum": ["practitioner", "mentor"],
          "maxLength": 24
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "sprintId",
        "sprintTitle",
        "mentorId",
        "mentorName",
        "sender",
        "body",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PractitionerProfile" },
      "description": "Owner-isolated practitioner profile and preferences."
    },
    "/users/{userId}/capabilities/{capabilityId}": {
      "schema": { "$ref": "#/entities/SkillCapability" },
      "description": "Verified capabilities and optional trust evidence belonging to a practitioner."
    },
    "/users/{userId}/passports/{passportId}": {
      "schema": { "$ref": "#/entities/CompetencyPassport" },
      "description": "AI-verified Living Competency Passports owned by a practitioner."
    },
    "/users/{userId}/contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/BriefSubmission" },
      "description": "Paid problem-solving briefs accepted or completed by a practitioner."
    },
    "/users/{userId}/vaults/{vaultId}": {
      "schema": { "$ref": "#/entities/WorkReadyVault" },
      "description": "Owner-isolated Work-Ready Vault checklist and compliant payout readiness state."
    },
    "/users/{userId}/endorsements/{endorsementId}": {
      "schema": { "$ref": "#/entities/PeerEndorsement" },
      "description": "Peer endorsement requests and verified collaborator quotes linked to a practitioner's passport."
    },
    "/users/{userId}/payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/ContractPayout" },
      "description": "Contract payout lifecycle records tracking Escrow Held, Processing, and Released statuses."
    },
    "/users/{userId}/sprintFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/SprintFeedback" },
      "description": "Hiring Partner qualitative star ratings and reviews for completed sprint contributions."
    },
    "/users/{userId}/mentorMessages/{messageId}": {
      "schema": { "$ref": "#/entities/MentorMessage" },
      "description": "Pod mentorship messaging thread records between a practitioner and assigned Senior Specialist."
    }
  }
}
