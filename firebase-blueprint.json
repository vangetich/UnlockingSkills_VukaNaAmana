  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PractitionerProfile" },
      "description": "Owner-isolated practitioner profile and preferences."
    },
    "/users/{userId}/capabilities/{capabilityId}": {
      "schema": { "$ref": "#/entities/SkillCapability" },
      "description": "Verified capabilities and optional trust evidence belonging to a practitioner."
    },
    "/users/{userId}/passports/{passportId}": {
      "schema": { "$ref": "#/entities/CompetencyPassport" },
      "description": "AI-verified Living Competency Passports owned by a practitioner."
    },
    "/users/{userId}/contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/BriefSubmission" },
      "description": "Paid problem-solving briefs accepted or completed by a practitioner."
    },
    "/users/{userId}/vaults/{vaultId}": {
      "schema": { "$ref": "#/entities/WorkReadyVault" },
      "description": "Owner-isolated Work-Ready Vault checklist and compliant payout readiness state."
    },
    "/users/{userId}/endorsements/{endorsementId}": {
      "schema": { "$ref": "#/entities/PeerEndorsement" },
      "description": "Peer endorsement requests and verified collaborator quotes linked to a practitioner's passport."
    },
    "/users/{userId}/payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/ContractPayout" },
      "description": "Contract payout lifecycle records tracking Escrow Held, Processing, and Released statuses."
    },
    "/users/{userId}/sprintFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/SprintFeedback" },
      "description": "Hiring Partner qualitative star ratings and reviews for completed sprint contributions."
    },
    "/users/{userId}/mentorMessages/{messageId}": {
      "schema": { "$ref": "#/entities/MentorMessage" },
      "description": "Pod mentorship messaging thread records between a practitioner and assigned Senior Specialist."
    },
    "/users/{userId}/mentorshipSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/MentorshipSession" },
      "description": "Structured mentoring sessions logged or scheduled for sprint QA and velocity tracking."
    },
    "/users/{userId}/mentorPairings/{pairingId}": {
      "schema": { "$ref": "#/entities/MentorPairingRequest" },
      "description": "Formal mentorship track pairing requests tied to practitioner active sprint goals."
    },
    "/users/{userId}/mentorRatings/{ratingId}": {
      "schema": { "$ref": "#/entities/MentorRating" },
      "description": "Practitioner 5-point mentorship ratings and feedback comments for track accountability."
    },
    "/users/{userId}/mentorshipTrackProgress/{trackId}": {
      "schema": { "$ref": "#/entities/MentorshipTrackProgress" },
      "description": "Synced learning objective mastery records per mentorship track."
    },
    "/users/{userId}/mentorshipJournal/{entryId}": {
      "schema": { "$ref": "#/entities/MentorshipJournalEntry" },
      "description": "Owner-private, dated reflections on mentorship sessions for a deeper record of practitioner growth."
    },
    "/users/{userId}/menteeCompetencyBadges/{badgeId}": {
      "schema": { "$ref": "#/entities/MenteeCompetencyBadge" },
      "description": "Digital skill badges awarded by mentors upon Pod Sprint completion and displayed in the mentee's CompetencyPassport."
    },
    "/users/{userId}/mentorMilestoneFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/MentorMilestoneFeedback" },
      "description": "Structured milestone ratings and constructive mentor feedback across project milestones."
    },
    "/users/{userId}/mentorshipSessionAgendas/{agendaId}": {
      "schema": { "$ref": "#/entities/MentorshipSessionAgendaRecord" },
      "description": "Bulleted pre-session agendas created and shared with mentors to keep scheduled sessions focused and tracked."
    },
    "/users/{userId}/collaborationNotes/{noteId}": {
      "schema": { "$ref": "#/entities/CollaborationNote" },
      "description": "Owner-private markdown reflections on sprint team dynamics and collaboration."
    },
    "/users/{userId}/mentorPeerReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/MentorPeerReview" },
      "description": "Formative mentor peer reviews evaluating sprint teamwork cohesion, problem framing, and communication."
    },
    "/pods/{sprintId}/discussions/{postId}": {
      "schema": { "$ref": "#/entities/SprintDiscussionPost" },
      "description": "Shared sprint pod discussion threads and deliverable resource links across pod members."
    }
  }
