{
  "entities": {
    "PractitionerProfile": {
      "title": "PractitionerProfile",
      "description": "Private practitioner profile, problem-solving focus, career stage, and sync preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the practitioner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Practitioner preferred name."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified account email (owner-only PII)."
        },
        "problemStatement": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "Answer to: What real-world problems do you know how to solve?"
        },
        "ageStage": {
          "type": "string",
          "enum": ["15-17", "18-29", "30-45", "46+", "15-19", "20-29"],
          "maxLength": 16,
          "description": "Career age-stage selection."
        },
        "preferredLocale": {
          "type": "string",
          "enum": ["en", "sw", "fr", "ar", "uk", "es"],
          "maxLength": 8,
          "description": "Preferred UI language code."
        },
        "themePreference": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 8,
          "description": "Preferred color theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "problemStatement",
        "ageStage",
        "preferredLocale",
        "themePreference",
        "createdAt",
        "updatedAt"
      ]
    },
    "SkillCapability": {
